{
  "name": "aegis-cmo-wargame",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "docs:api": "typedoc",
    "preview": "vite preview",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:coverage": "bun test tests/unit tests/integration --coverage --coverage-reporter=text --coverage-reporter=lcov && bun run scripts/checkEngineCoverage.ts",
    "test:e2e": "playwright test",
    "validate:db": "bun run scripts/validateDb.ts",
    "smoke:scenarios": "bun run scripts/smokeScenarios.ts",
    "smoke:scenarios:check": "bun run scripts/smokeScenarios.ts --check",
    "bench:engine": "bun run scripts/benchmarkEngine.ts",
    "bench:browser": "bun run scripts/benchmarkBrowser.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@turf/turf": "^7.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.1.0",
    "milsymbol": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.1.0",
    "three": "^0.187.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typedoc": "^0.28.20",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
